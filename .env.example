# Research Workflow — example env (copy to .env and fill in)

# === Auth (Google OAuth) ===
# Copy this file to `.env` and fill in values. Backend loads `.env` via run_backend.py.
# Create OAuth 2.0 credentials in Google Cloud Console (Web application).
# Authorized redirect URIs must match what the app sends (see FRONTEND_URL below).
# Local dev with Vite: use http://localhost:48722/auth/callback — NOT the raw backend port.
# Optional: set OAUTH_REDIRECT_URI to override (full URL to /auth/callback).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session cookie signing (use a long random string in production)
SESSION_SECRET=dev-secret-change-in-production

# Frontend URL (for redirects after login/logout; Vite default in this repo is FRONTEND_PORT=48722)
FRONTEND_URL=http://localhost:48722

# Backend port (must match Vite proxy and optional VITE_BACKEND_PORT for dev fallback).
# Project-root `.env` wins over a stale shell export — if the proxy ever targets the wrong port, run:
#   unset BACKEND_PORT FRONTEND_PORT
# BACKEND_PORT=48721
# VITE_BACKEND_PORT=48721

# Development only: required for "Bypass login (development)" when GOOGLE_CLIENT_ID is set.
# Without this, /auth/dev-login returns 403. Do not set in production.
# BYPASS_AUTH_DEV=1

# Optional: extra emails with platform superuser (comma-separated). dev@local is always superuser.
# SUPERUSER_EMAILS=you@company.com

# Optional: comma-separated Google email domains allowed to sign in (defaults to umn.edu when unset)
# GOOGLE_ALLOWED_EMAIL_DOMAINS=umn.edu

# === MCP / tool HTTP API (POST /v1/tools/invoke) ===
# Optional: comma-separated legacy keys (still supported). Prefer creating keys in Platform → API keys.
# MCP_API_KEY=...
# MCP_API_KEYS=key1,key2
# Optional pepper for hashing keys stored in the datastore (recommended in production).
# MCP_API_KEY_PEPPER=long-random-string

# === Datastore ===
# Use mock (in-memory) for local dev; use mariadb for production.
DATASTORE=memory

# For production (DATASTORE=mariadb), set:
# DATABASE_URL=mysql://user:password@host:3306/database_name

# === Pipeline (optional when using UI) ===
# When using the UI, config (tokens, Box config, etc.) is stored in the database per study.
# No config files (ui_config.json, box.config.json) are required. For standalone pipeline runs,
# set env vars as needed:
# QUALTRICS_API_TOKEN=...
# GRID_API_TOKEN=...
# BOX_ROOT_FOLDER_ID=...
# etc.

# Custom component storage (persist this path in Docker)
# Default in app code is backend/custom_components, but you can override it here.
# CUSTOM_COMPONENTS_DIR=backend/custom_components
