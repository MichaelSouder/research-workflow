# Copy to .env.production on the server (never commit real secrets).
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d

# --- Public URL (HTTPS) — required for OAuth redirects and session cookies ---
FRONTEND_URL=https://lnpiapp2.med.umn.edu

# Must include the same origin as FRONTEND_URL (comma-separated)
CORS_ORIGINS=https://lnpiapp2.med.umn.edu

# Google OAuth (create a "Web application" client; authorized redirect URI must match)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Long random string (openssl rand -hex 32)
SESSION_SECRET=

# Secure cookies (set by docker-compose.prod.yml; keep for clarity)
HTTPS=1

# Bind backend API to loopback only on the host (frontend still reaches it via Docker network)
BACKEND_PUBLISH=127.0.0.1:48721:48721

# How the stack publishes the web UI (use 127.0.0.1:48722:80 if only the host reverse proxy should connect)
FRONTEND_PUBLISH=0.0.0.0:48722:80

# --- Database ---
# External production MariaDB (recommended): run app containers without local `db` service.
DATASTORE=mariadb
# Fill in your production DB host/user/password/schema (never commit real values here):
DATABASE_URL=mysql://db_user:db_password@db-host.example.edu:3306/pipeline_db
#
# If your password has special characters, URL-encode it (e.g. @ -> %40).
#
# Local-compose db mode (optional; not for external production DB):
# DATABASE_URL=mysql://pipeline:pipeline@db:3306/pipeline_db
# MARIADB_ROOT_PASSWORD=
# MARIADB_PASSWORD=

# Optional: platform superusers (comma-separated emails)
# SUPERUSER_EMAILS=you@umn.edu

# Optional: comma-separated Google email domains allowed to sign in (defaults to umn.edu when unset)
# GOOGLE_ALLOWED_EMAIL_DOMAINS=umn.edu

# Optional: MCP API key pepper for hashed keys in DB
# MCP_API_KEY_PEPPER=

# Optional: app subpath for frontend build/routing (must start/end with `/`), e.g. /research-workflow/
# VITE_APP_BASE_PATH=/

# Public base URL for ChatGPT / MCP bridge (same host as the UI if nginx proxies /v1). Defaults to FRONTEND_URL.
# TOOL_API_PUBLIC_BASE_URL=https://lnpiapp2.med.umn.edu

# Optional: set to 0/false/no to disable data proxy for env-based MCP_API_KEY / MCP_API_KEYS (default: proxy on).
# TOOL_API_ENV_KEY_DATA_PROXY=0
